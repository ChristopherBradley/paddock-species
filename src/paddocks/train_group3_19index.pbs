#!/bin/bash
#PBS -N g3_19index
#PBS -P xe2
#PBS -q normal
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/xe2+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/

# Full validation run of the 19-index candidate model from INDEX_ARCHITECTURE_SWEEP.md's round
# 2 (orig. 8 + round-1's 5 + Sharma et al. 2026's 6, --bands-drop-raw so only the 19 derived
# indices are used, no raw bands) — the best arm of that sweep (0.892 temporal / 0.884 spatial
# macro F1 vs. shipped 0.821/0.823), which was run there with --importance-repeats 0 to keep
# the sweep cheap. This is the real run: --importance-repeats 5 (matching
# train_group3_reviewed.pbs's convention) plus BOTH confusion-matrix figures now that
# plot_confusion/--spatial-confusion-png exist (previously only the temporal split got one).
#
# Same --keep/--test-keep as GROUP3_reviewed.md, so this is the direct, apples-to-apples
# successor report to it, not a differently-scored arm.
#
# 12 CPUs: permutation_importance dominates runtime and scales with feature count (333 features
# here vs. 51 in GROUP3_reviewed.md) as well as cores -- expect several x GROUP3_reviewed.md's
# ~75s on 12 CPUs.
set -euo pipefail
export PROJ_NETWORK=OFF
export OMP_NUM_THREADS=1
PY=/g/data/xe2/John/geospatenv/bin/python
D=/scratch/xe2/cb8590/paddock-species-data/derived
REPO=/home/147/cb8590/Projects/paddock-species
cd $REPO/src/paddocks

$PY train_species.py \
    --bands "$D/samgeo/bands_ts/*_SENSITIVE.csv" --bands-drop-raw \
    --labeled $D/nvt_trials_labeled.csv \
    --keep $D/keep_arms/keep_reviewed_SENSITIVE.csv \
    --test-keep $D/keep_arms/testkeep_temporal_SENSITIVE.csv \
    --target group3 --model hgb --importance-repeats 5 \
    --confusion-png $REPO/output/figures/confusion_group3_19index_temporal.png \
    --spatial-confusion-png $REPO/output/figures/confusion_group3_19index_spatial.png \
    --out $REPO/output/GROUP3_MODEL_19index.md
echo "Done train_group3_19index"
