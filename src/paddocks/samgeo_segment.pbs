#!/bin/bash
#PBS -N samgeo_bench
#PBS -P xe2
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=90GB
#PBS -l jobfs=50GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/xe2+gdata/v10+gdata/ka08+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/

# SAMGeo arm of the paddock-boundary benchmark. gpuvolta is the smallest GPU unit on gadi
# (1 GPU comes with 12 CPUs), which is what makes this expensive relative to the FTW arm —
# that one costs 0 SU because it is just a network read from a login node.
#
# No internet needed: the SAM checkpoint is already on /g/data and PROJ_NETWORK is off, so
# this does NOT require -q copyq.

set -euo pipefail
: "${LAT:?set -v LAT=}" ; : "${LON:?set -v LON=}" ; : "${STUB:?set -v STUB=}"
BUFFER=${BUFFER:-0.05}
START=${START:-2020-01-01}
END=${END:-2020-12-31}
OUTDIR=${OUTDIR:-/scratch/xe2/cb8590/paddock-species-data/derived/samgeo}

export PROJ_NETWORK=OFF
export DATACUBE_CONFIG_PATH=/g/data/v10/public/modules/dea/20231204/datacube.conf
PY=/g/data/xe2/John/geospatenv/bin/python

cd /home/147/cb8590/Projects/paddock-species/src/paddocks
echo "SAMGeo benchmark: lat=$LAT lon=$LON buffer=$BUFFER stub=$STUB"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

$PY samgeo_segment.py --lat "$LAT" --lon "$LON" --buffer "$BUFFER" \
    --start "$START" --end "$END" --outdir "$OUTDIR" --stub "$STUB"
echo "Done $STUB"
