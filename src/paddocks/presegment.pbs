#!/bin/bash
#PBS -N presegment
#PBS -P xe2
#PBS -q normalbw
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/xe2+gdata/v10+gdata/ka08+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/
# QUEUE: normalbw bills 8 GB on 1 CPU as one core (1.25 SU/h) where normal bills it as two (4.0 SU/h);
# this stage's process RSS peaks near 0.5 GB and its outputs are bit-identical across queues
# (output/BENCH_KSU.md, 2026-09-09), so the queue is only a price.

# Stage 1: Fourier-of-NDWI composites. Pure datacube I/O + one FFT — NO GPU.
# On `normal` the charge is max(ncpus, mem/4GB) x 2 SU/hr, so 1 CPU / 4 GB is the cheapest
# bookable unit and anything larger must earn its keep in walltime. Defaults are that unit;
# override per-job with `qsub -l ncpus=N -l mem=XGB`.
#
# Sized for the ~3 km AOIs that make_aois.py produces (~300x300 px x ~70 scenes).
#
# 4 GB IS NOT ENOUGH FOR RECENT YEARS. On the 1,362-AOI run this OOM-killed (exit 137) the
# chunk holding the 2024 AOIs: S2A+S2B+S2C now fly, so revisit density — and therefore the
# NDWI cube held in memory — is far higher than in the 2017-2020 years the 4 GB figure was
# benchmarked on. Memory scales with n_scenes x pixels, so use `-l mem=8GB` for 2023+ or for
# any AOI wider than ~5 km. That doubles the charge (normal bills max(ncpus, mem/4GB)), which
# is why it is not the default for the older, cheaper majority.

set -euo pipefail
: "${AOIS:?set -v AOIS=}"
OUTDIR=${OUTDIR:-/scratch/xe2/cb8590/paddock-species-data/derived/samgeo}

export PROJ_NETWORK=OFF          # compute nodes have no internet; see MEMORY.md root cause
# numpy hints MADV_HUGEPAGE on every large array and gadi runs THP defrag=madvise, so the kernel
# compacts memory synchronously on those faults: the same 9 km tile ran predict's zonal step in
# 22-25 s with this off vs 41-396 s with it on, all in system time (PROJ_NOTES 2026-09-09).
export NUMPY_MADVISE_HUGEPAGE=0
export DATACUBE_CONFIG_PATH=/g/data/v10/public/modules/dea/20231204/datacube.conf
PY=/g/data/xe2/John/geospatenv/bin/python

cd /home/147/cb8590/Projects/paddock-species/src/paddocks
echo "presegment AOIS=$AOIS OUTDIR=$OUTDIR ncpus=${PBS_NCPUS:-?}"
$PY samgeo_segment.py presegment --aois "$AOIS" --outdir "$OUTDIR" ${PRESEG_EXTRA:-}
echo "Done presegment"
