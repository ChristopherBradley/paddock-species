#!/bin/bash
#PBS -N pilot_spatial_stability
#PBS -P xe2
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=16:00:00
#PBS -l storage=gdata/xe2+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/

# One-off pilot: --spatial-match doesn't shard yet (see polygon_stability.py's help text), so
# this is a single unsharded pass over the full combined 9-year corpus (8 fixed years + 1
# offset-2024 year), budgeted like stability.pbs's own ~9 CPU-hour estimate for 10,404 files
# but with generous headroom (16h) since the whole-region candidate search is unmeasured at
# this scale. Not meant to be reusable production infrastructure -- see run_map100.sh's
# `stability`/`stability-merge` cases for the sharded default-mode path this project actually
# ships.

set -euo pipefail
: "${POLYDIR:?set -v POLYDIR=}"
: "${AOIS:?set -v AOIS=}"
: "${OUT:?set -v OUT=}"
: "${CONSENSUS:?set -v CONSENSUS=}"
: "${REPORT:?set -v REPORT=}"

export PROJ_NETWORK=OFF
# numpy hints MADV_HUGEPAGE on every large array and gadi runs THP defrag=madvise, so the kernel
# compacts memory synchronously on those faults: the same 9 km tile ran predict's zonal step in
# 22-25 s with this off vs 41-396 s with it on, all in system time (PROJ_NOTES 2026-09-09).
export NUMPY_MADVISE_HUGEPAGE=0
PY=/g/data/xe2/John/geospatenv/bin/python
cd /home/147/cb8590/Projects/paddock-species/src/paddocks

echo "pilot spatial stability POLYDIR=$POLYDIR AOIS=$AOIS"
$PY polygon_stability.py --polydir "$POLYDIR" --spatial-match --min-containment 0.5 \
    --aois "$AOIS" --min-years 5 --out "$OUT" --consensus "$CONSENSUS" \
    ${PRED:+--pred "$PRED"} ${EXTRA_ARGS:-} --report "$REPORT"
echo "Done pilot spatial stability"
