#!/bin/bash
#PBS -N sam_pps
#PBS -P xe2
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=90GB
#PBS -l jobfs=50GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/xe2+gdata/v10+gdata/ka08+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/

# sam_segment.pbs, but with --points-per-side exposed as $PPS.
#
# WHY A SEPARATE FILE. sam_segment.pbs hard-codes the library default (points_per_side=32) by
# omission, and every national/benchmark output on disk was produced that way. The tile-size v2
# benchmark needs to vary that one knob while holding everything else identical, and the
# production wrapper must keep reproducing exactly what it has always produced.
#
# OUTDIR MUST DIFFER PER PPS. samgeo_segment.py skips any AOI whose _filt.gpkg already exists,
# which is what makes it restartable — and also what would silently return the OLD pps's
# polygons if two settings shared a directory. Use SEED_FROM to share the composites (which do
# not depend on pps) and a fresh OUTDIR for the polygons (which do).

set -euo pipefail
: "${AOIS:?set -v AOIS=}"
: "${PPS:?set -v PPS= (SAM points_per_side; library default 32)}"
OUTDIR=${OUTDIR:?set -v OUTDIR=}

export PROJ_NETWORK=OFF
# numpy hints MADV_HUGEPAGE on every large array and gadi runs THP defrag=madvise, so the kernel
# compacts memory synchronously on those faults: the same 9 km tile ran predict's zonal step in
# 22-25 s with this off vs 41-396 s with it on, all in system time (PROJ_NOTES 2026-09-09).
export NUMPY_MADVISE_HUGEPAGE=0
export DATACUBE_CONFIG_PATH=/g/data/v10/public/modules/dea/20231204/datacube.conf
PY=/g/data/xe2/John/geospatenv/bin/python

cd /home/147/cb8590/Projects/paddock-species/src/paddocks
if [ -n "${SEED_FROM:-}" ]; then
    mkdir -p "$OUTDIR"
    ln -sf "$SEED_FROM"/*.tif "$OUTDIR"/ 2>/dev/null || true
    rm -f "$OUTDIR"/*_segment.tif        # a mask is an output, not an input
    echo "seeded $(ls "$OUTDIR"/*.tif 2>/dev/null | wc -l) composites from $SEED_FROM"
fi
echo "sam_segment_pps AOIS=$AOIS OUTDIR=$OUTDIR PPS=$PPS"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "no GPU"
$PY samgeo_segment.py segment --aois "$AOIS" --outdir "$OUTDIR" --points-per-side "$PPS"
echo "Done sam_segment_pps"
