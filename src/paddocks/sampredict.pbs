#!/bin/bash
#PBS -N sampredict
#PBS -P xe2
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=90GB
#PBS -l jobfs=20GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/xe2+gdata/v10+gdata/ka08+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/
# SAM + predict in one GPU job (segment_predict.py): SAM on the GPU, predict_tile.py on the 11
# spare cores as each tile's polygons land. For the 9 km pipeline (TILE_GEOMETRY_DECISION.md,
# FUSED_PREDICT_BENCHMARK.md). Memory: 11 x ~7 GB predict RSS at 9 km + SAM fits in 90 GB.
# Predict-only top-up on CPU (SAM already done, e.g. after a walltime kill):
#   qsub -q normalbw -l ncpus=4,ngpus=0,mem=34GB -v "...,WORKERS=4,ORCH_EXTRA=--no-sam" sampredict.pbs
set -euo pipefail
: "${AOIS:?set -v AOIS=}" "${OUTDIR:?}" "${PREDDIR:?}" "${MODEL:?}"
export PROJ_NETWORK=OFF
# numpy hints MADV_HUGEPAGE on every large array and gadi runs THP defrag=madvise, so the kernel
# compacts memory synchronously on those faults: the same 9 km tile ran predict's zonal step in
# 22-25 s with this off vs 41-396 s with it on, all in system time (PROJ_NOTES 2026-09-09).
export NUMPY_MADVISE_HUGEPAGE=0
export DATACUBE_CONFIG_PATH=/g/data/v10/public/modules/dea/20231204/datacube.conf
PY=/g/data/xe2/John/geospatenv/bin/python
cd /home/147/cb8590/Projects/paddock-species/src/paddocks
echo "sampredict AOIS=$AOIS OUTDIR=$OUTDIR PREDDIR=$PREDDIR MODEL=$MODEL workers=${WORKERS:-11} sam='${SAM_EXTRA:-}' predict='${EXTRA_ARGS:-}'"
$PY segment_predict.py --aois "$AOIS" --outdir "$OUTDIR" --pred-dir "$PREDDIR" --model "$MODEL" \
    --workers "${WORKERS:-11}" --sam-args "${SAM_EXTRA:-}" --predict-args "${EXTRA_ARGS:-}" ${ORCH_EXTRA:-}
echo "Done sampredict"
