#!/bin/bash
#PBS -N bench_pred
#PBS -P xe2
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/xe2+gdata/v10+gdata/ka08+scratch/xe2
#PBS -l wd
#PBS -o /scratch/xe2/cb8590/paddock-species-logs/
#PBS -e /scratch/xe2/cb8590/paddock-species-logs/
# Benchmark variant of predict_tile.pbs: queue/mem set at qsub time, RSS + cgroup sampled.
set -euo pipefail
: "${AOIS:?}" "${POLYDIR:?}" "${MODEL:?}" "${OUT:?}"
export PROJ_NETWORK=OFF
# numpy hints MADV_HUGEPAGE on every large array and gadi runs THP defrag=madvise, so the kernel
# compacts memory synchronously on those faults: the same 9 km tile ran predict's zonal step in
# 22-25 s with this off vs 41-396 s with it on, all in system time (PROJ_NOTES 2026-09-09).
export NUMPY_MADVISE_HUGEPAGE=0
# one thread: a 1-core cgroup, and numpy would otherwise spawn a thread per node core
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export DATACUBE_CONFIG_PATH=/g/data/v10/public/modules/dea/20231204/datacube.conf
PY=/g/data/xe2/John/geospatenv/bin/python
cd /home/147/cb8590/Projects/paddock-species/src/paddocks
mkdir -p "$(dirname "$OUT")"
echo "BENCH predict job=$PBS_JOBID queue=$PBS_QUEUE aois=$AOIS out=$OUT host=$(hostname) start=$(date +%s)"
$PY predict_tile.py --aois "$AOIS" --polydir "$POLYDIR" --model "$MODEL" --out "$OUT" \
    --timings "${OUT%.gpkg}_timings.csv" ${EXTRA_ARGS:-} &
PID=$!
bash bench/memsample.sh $PID 20 "${OUT%.gpkg}_memsample.log" &
wait $PID
echo "BENCH end=$(date +%s)"
echo "Done predict_tile"
